@using PatientPortal.Models
@model Comment

@{
    ViewData["Title"] = "Edit Comment";
}

<h1>Edit Comment</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="mb-2">
                <label class="form-label">Author</label>
                <input class="form-control" value="@Model.AuthorDisplayName (@Model.AuthorType)" disabled />
            </div>

            <div class="mb-2">
                <label for="bodyText" class="form-label">Message</label>
                <textarea id="bodyText" name="bodyText" class="form-control" rows="4">@Model.BodyText</textarea>
            </div>

            <div class="mb-2">
                <label for="status" class="form-label">Status</label>
                <input id="status" name="status" class="form-control" value="@Model.Status" />
            </div>

            <div class="mb-2">
                <label for="visibility" class="form-label">Visibility</label>
                <input id="visibility" name="visibility" class="form-control" value="@Model.Visibility" />
            </div>

            <div class="form-check mb-3">
                <input type="checkbox"
                       class="form-check-input"
                       id="isFlagged"
                       name="isFlagged"
                       value="true"
                       @(Model.IsFlagged ? "checked" : "") />
                <label class="form-check-label" for="isFlagged">Flagged</label>
            </div>

            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Index" class="btn btn-secondary">Back to list</a>
        </form>
    </div>
</div>
